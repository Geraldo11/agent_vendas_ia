# Copie para .env (nunca versionar). Token: Databricks > Settings > Developer > Access tokens
DATABRICKS_HOST=https://SEU-WORKSPACE.cloud.databricks.com
DATABRICKS_TOKEN=coloque_o_token_aqui

# Só o ID do warehouse (a parte FINAL do "HTTP path"), sem o caminho.
# Ex.: se o HTTP path é /sql/1.0/warehouses/5743803c731887dd, use 5743803c731887dd
# Onde ver: Compute > SQL Warehouses > seu warehouse > Connection details
DATABRICKS_WAREHOUSE_ID=coloque_o_id_do_warehouse_aqui

# ---- Modelo de linguagem (escolha UM provedor) ----
# Descomente as linhas de UM provedor e preencha. NÃO deixe linhas vazias do tipo NOME= (elas anulam valores).
# Formato: NOME=valor, sem espaço no início da linha e sem aspas.
# A) Modelo aberto hospedado no seu workspace Databricks (reaproveita HOST e TOKEN acima)
#    Veja os nomes com:  databricks serving-endpoints list
# LLM_PROVIDER=databricks
# LLM_MODEL=nome-do-endpoint

# G) Groq (modelos abertos, API compatível; plano gratuito com limites por minuto e por dia)
#    Chave: console.groq.com > API Keys > Create. Cole só o valor (começa com gsk_), sem aspas.
#    Modelos MUDAM e são descontinuados: rode  python scripts/listar_modelos.py  para ver os da sua chave.
#    O modelo precisa suportar tool use (o passo [2/3] de scripts/testar_llm.py confirma).
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=coloque_a_chave_aqui

# B) Modelo aberto rodando na sua máquina com Ollama
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b
# (opcional) LLM_BASE_URL=http://host.docker.internal:11434/v1

# C) Outro servidor compatível com a API da OpenAI
# LLM_PROVIDER=compat
# LLM_BASE_URL=https://...
# LLM_API_KEY=sua_chave
# LLM_MODEL=nome-do-modelo

